FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PHYLAX_HOME=/opt/phylax \
    PHYLAX_TRACK=skills

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates git build-essential \
        && rm -rf /var/lib/apt/lists/*

WORKDIR ${PHYLAX_HOME}
COPY requirements.txt ./
RUN pip install --upgrade pip && pip install -r requirements.txt

RUN pip install --force-reinstall bittensor==11.0.1 \
 && pip uninstall -y bittensor-wallet bittensor-cli scalecodec cyscale \
 && pip install --no-deps cyscale \
 && pip uninstall -y scalecodec

COPY . .
RUN pip install -e .

EXPOSE 8091
CMD ["python", "neurons/miner.py"]
