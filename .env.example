# Copy to .env and fill in your values. Do NOT commit .env.
# Read by neurons/miner.py, neurons/validator.py, scripts/*, and docker compose.

# ───────────────────────── Bittensor ─────────────────────────
PHYLAX_NETUID=486
SUBTENSOR_NETWORK=test
# Options: test | finney | local

WALLET_NAME=miner
WALLET_HOTKEY=default
# Wallet directory. Default is fine for standard installs.
BITTENSOR_DIR=~/.bittensor

# Axon (miners only). The miner serves an axon on this port so validators can
# dispatch tasks to it. Publish this port and make it reachable. Set
# PHYLAX_AXON_EXTERNAL_IP to the address validators should reach (the host's
# public/LAN IP); leave blank to let bittensor auto-detect.
PHYLAX_AXON_PORT=8091
PHYLAX_AXON_EXTERNAL_IP=

# ───────────────────────── Track ─────────────────────────────
# The single track this node commits to. A hotkey lives in exactly one.
# One of: skills | mcp_servers | packages | repositories
PHYLAX_TRACK=skills

# ───────────────── phylax-server (control plane) ─────────────────
PHYLAX_SERVER_URL=https://api.phyi.dev

# Pin the server's ed25519 identity so the client refuses an impersonator.
# Fetch once with: curl https://api.phyi.dev/v1/server-identity
PHYLAX_SERVER_HOTKEY=a53f8e390446e31cd077517e44e585c0e0474bbd5b1db5864c52fb07bcbe541c

# ───────────────────────── Miner: agent ──────────────────────
# REQUIRED for miners. Validators ignore these.

# Inference key that funds your agent. Must start with 'cpk_' (Chutes) or
# 'sk-or-' (OpenRouter). The validator meters reruns through the same key.
PHYLAX_EXECUTION_API_KEY=
# Optional model id passed to your agent.
PHYLAX_INFERENCE_MODEL=

# Your agent file and entrypoint. Defaults to the bundled reference agent.
PHYLAX_AGENT_PATH=
PHYLAX_AGENT_ENTRYPOINT=agent_main

# The image the validator pulls (by digest) to rerun your agent. Build with:
#   ./scripts/build-agent.sh <registry>/<you>/<image>:<tag>
# and paste the printed values here.
PHYLAX_SANDBOX_IMAGE=
PHYLAX_SANDBOX_DIGEST=

# Optional dependency manifest stored alongside the submission.
PHYLAX_DEPENDENCY_MANIFEST=
# Friendly label shown in dashboards.
PHYLAX_MINER_LABEL=
# Seconds between task requests.
PHYLAX_MINER_INTERVAL=20

# ───────────────────────── Execution sandbox ─────────────────
# sandbox = run the agent in-process; docker = run the registered image jailed.
PHYLAX_EXECUTOR=docker
# Metered LLM egress reachable from inside the jail.
PHYLAX_INFERENCE_PROXY_URL=
# Internal docker network for jailed agents.
PHYLAX_JAIL_NETWORK=phylax-jail
# Per-run timeout (seconds).
PHYLAX_AGENT_TIMEOUT=120
# Container resource limits.
PHYLAX_SANDBOX_MEMORY=2g
PHYLAX_SANDBOX_CPUS=2
PHYLAX_SANDBOX_PIDS=256
# Inference proxy bind address (leave defaults unless you relocate it).
PHYLAX_PROXY_HOST=127.0.0.1
PHYLAX_PROXY_PORT=8923

# ───────────────────────── Validator ─────────────────────────
# REQUIRED for validators. Miners ignore these.
PHYLAX_VALIDATOR_LABEL=
# Per-track round overrides. Defaults come from phylax/rounds.py.
#PHYLAX_ROUND_BLOCKS=
#PHYLAX_TASKS_PER_ROUND=
#PHYLAX_REPETITIONS=
#PHYLAX_TASK_TIMEOUT=
# Minimum round score to receive weight.
PHYLAX_SCORE_THRESHOLD=0.6
# Minimum fraction of repetitions that must be correct.
PHYLAX_RELIABILITY_FRACTION=0.5
# Seconds between block polls.
PHYLAX_POLL_INTERVAL=30
# Host docker group GID so the jailed executor can reach the docker socket.
DOCKER_GID=
# ss58 hotkey whose on-chain commitment holds the recognized-contributor set
# for the 5% pool. The subnet owner publishes it with
# scripts/publish_contributors.py. Leave blank to keep the pool dormant.
PHYLAX_CONTRIBUTOR_AUTHORITY=

# ───────────────────────── Logging ───────────────────────────
PHYLAX_LOG_LEVEL=INFO
# DEBUG | INFO | WARNING | ERROR
