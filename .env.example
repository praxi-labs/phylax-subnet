# Copy to .env and fill in your values. Do NOT commit .env.
# All keys are read by neurons/miner.py, neurons/validator.py, and scripts/*.

# ───────────────────────── Bittensor ─────────────────────────
PHYLAX_NETUID=1
SUBTENSOR_NETWORK=test
# Options: test | finney | local

# Miner wallet
WALLET_NAME=miner
WALLET_HOTKEY=default

# Validator wallet (only needed when running a validator)
WALLET_NAME_VAL=validator

# ───────────────────────── Miner pipeline ────────────────────
# Path to docker image for sandbox detonation
PHYLAX_SANDBOX_IMAGE=phylax-sandbox:latest

# Sandbox execution timeout (seconds, multiplied 5x for deep profile)
SANDBOX_TIMEOUT=120

# Where to put per-run evidence artifacts on the miner host
PHYLAX_EVIDENCE_DIR=/var/lib/phylax/evidence

# ───────────────────────── Validator ─────────────────────────
TASKS_PER_ROUND=10
QUERY_TIMEOUT=120

# ───────────────────────── Logging ───────────────────────────
PHYLAX_LOG_LEVEL=INFO
# DEBUG | INFO | WARNING | ERROR
