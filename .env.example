# Copy to .env and fill in your values. Do NOT commit .env.
# All keys are read by neurons/miner.py, neurons/validator.py, and scripts/*.

# ───────────────────────── Bittensor ─────────────────────────
PHYLAX_NETUID=1
SUBTENSOR_NETWORK=test
# Options: test | finney | local

# Miner wallet
WALLET_NAME=miner
WALLET_HOTKEY=default

# Validator wallet (only needed when running a validator)
WALLET_NAME_VAL=validator

# ───────────────────────── Miner pipeline ────────────────────
# Path to docker image for sandbox detonation
PHYLAX_SANDBOX_IMAGE=phylax-sandbox:latest

# Sandbox execution timeout (seconds, multiplied 5x for deep profile)
SANDBOX_TIMEOUT=120

# Where to put per-run evidence artifacts on the miner host
PHYLAX_EVIDENCE_DIR=/var/lib/phylax/evidence

# ───────────────────────── Validator ─────────────────────────
TASKS_PER_ROUND=10
QUERY_TIMEOUT=120

# ───────────────── phylax-server (control plane) ─────────────────
# Base URL of the phylax-server instance the validator talks to.
# When unset the validator cannot fetch tasks or set weights on-chain.
PHYLAX_SERVER_URL=https://54-225-20-32.nip.io

# Friendly label shown in server dashboards. Leave blank to inherit the
# operator's allowlist label.
PHYLAX_VALIDATOR_LABEL=

# Local cache path for the validator's signed-attestation registry.
PHYLAX_REGISTRY_PATH=

# false (default) = refuse to run rounds when phylax-server is unreachable.
# true  = score miners against the local corpus when offline. Weight pushes
# stay blocked either way because no fresh server attestation is obtainable.
PHYLAX_OFFLINE_FALLBACK=false

# Pin the server's ed25519 weight-attestation public key. When set, the
# client refuses any server that presents a different key — protects
# against the URL ever pointing at a rogue impersonator. Fetch once with:
#   curl https://54-225-20-32.nip.io/v1/server-identity
PHYLAX_SERVER_HOTKEY=a53f8e390446e31cd077517e44e585c0e0474bbd5b1db5864c52fb07bcbe541c

# ───────────────────────── Logging ───────────────────────────
PHYLAX_LOG_LEVEL=INFO
# DEBUG | INFO | WARNING | ERROR
