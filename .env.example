# Copy to .env and fill in your values. Do NOT commit .env.
# All keys are read by neurons/miner.py, neurons/validator.py, and scripts/*.

# ───────────────────────── Bittensor ─────────────────────────
PHYLAX_NETUID=486
SUBTENSOR_NETWORK=test
# Options: test | finney | local

# Used by docker compose to set --wallet.name / --wallet.hotkey in the
# command. The docker-compose files default these to miner/validator and
# default — override here if your wallet names differ.
WALLET_NAME=miner
WALLET_HOTKEY=default

# ───────────────────────── Miner specialization ──────────────
# REQUIRED for miners. Validators ignore these.
# The miner declares these to the coordinator via ./src/scripts/register.sh.
# Without them, register.sh exits with "PHYLAX_SUPPORTED_TYPES is not set"
# and the miner cannot receive routed tasks.

# Comma-separated skill types this miner serves IN ADDITION to declarative.
# 'declarative' is mandatory for every miner and is auto-added by the
# register helper / server, so you only list the EXTRA types here.
# Valid values: rag_knowledge,executable_python,executable_script,mcp_server,agent_composition
# Example: PHYLAX_SUPPORTED_TYPES=executable_python
PHYLAX_SUPPORTED_TYPES=

# ───────────────────────── Sandbox pipeline ──────────────────
# Sandbox image launched by the miner pipeline. Build a custom one with
# ./src/scripts/build-sandbox.sh <skill_type> <registry>/<you>/<image>:<tag>
# and paste the printed values below. The reference image earns Tier 1
# emissions out of the box.
PHYLAX_SANDBOX_IMAGE=ghcr.io/praxi-labs/phylax-sandbox:latest

# REQUIRED for runtime skill types. Content-addressable digest of
# PHYLAX_SANDBOX_IMAGE, starting with 'sha256:'. The build-sandbox.sh helper
# prints this for you, or grab it with:
#   docker inspect --format='{{index .RepoDigests 0}}' <image>
PHYLAX_SANDBOX_DIGEST=

# Sandbox execution timeout (seconds, multiplied 5× for deep profile).
SANDBOX_TIMEOUT=60

# Where the in-container pipeline writes per-run evidence. The published
# images set this to /opt/phylax/evidence and the compose files bind-mount
# the host's ./evidence to that path. Don't change unless you also adjust
# the compose volumes.
PHYLAX_EVIDENCE_DIR=/opt/phylax/evidence

# Host-side absolute path of the same evidence directory. The miner shells
# out to ``docker run -v`` through the host's docker socket, and dockerd
# resolves bind sources against the HOST filesystem — NOT the miner
# container's view. install.sh writes this automatically; only set it
# manually for non-standard installs.
PHYLAX_EVIDENCE_HOST_DIR=

# ───────────────────────── Validator ─────────────────────────
TASKS_PER_ROUND=10
QUERY_TIMEOUT=60

# ───────────────── phylax-server (control plane) ─────────────────
# Base URL of the phylax-server instance the validator talks to.
# When unset the validator cannot fetch tasks or set weights on-chain.
PHYLAX_SERVER_URL=https://54-225-20-32.nip.io

# Friendly label shown in server dashboards. Leave blank to inherit the
# operator's allowlist label.
PHYLAX_VALIDATOR_LABEL=

# Local cache path for the validator's signed-attestation registry. The
# compose file bind-mounts ./registry.sqlite3 here, so leave this set to the
# in-container path. (Leaving this blank is OK — the code falls back to a
# repo-local file — but the bind mount won't persist across container
# restarts in that case.)
PHYLAX_REGISTRY_PATH=/opt/phylax/registry.sqlite3

# false (default) = refuse to run rounds when phylax-server is unreachable.
# true  = score miners against the local corpus when offline. Weight pushes
# stay blocked either way because no fresh server attestation is obtainable.
PHYLAX_OFFLINE_FALLBACK=false

# Pin the server's ed25519 weight-attestation public key. When set, the
# client refuses any server that presents a different key — protects
# against the URL ever pointing at a rogue impersonator. Fetch once with:
#   curl https://54-225-20-32.nip.io/v1/server-identity
PHYLAX_SERVER_HOTKEY=a53f8e390446e31cd077517e44e585c0e0474bbd5b1db5864c52fb07bcbe541c

# ───────────────────────── Logging ───────────────────────────
PHYLAX_LOG_LEVEL=INFO
# DEBUG | INFO | WARNING | ERROR
