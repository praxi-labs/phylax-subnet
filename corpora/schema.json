{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Phylax Corpora Task",
  "description": "Ground-truth task definition consumed by validators. Each JSON file under known_bad/, known_good/, near_miss/, adversarial/, canaries/, regression/ or synthetic/ must conform to this schema.",
  "type": "object",
  "required": ["name", "bundle_hash", "expected_verdict"],
  "properties": {
    "name":         { "type": "string" },
    "description":  { "type": "string" },
    "bundle_hash":  { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "bundle_url":   { "type": "string", "format": "uri" },
    "bundle_bytes_b64": {
      "type": "string",
      "description": "Optional base64 of the bundle bytes. Useful for tiny corpus tasks that should not depend on remote hosting."
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name":        { "type": "string" },
        "version":     { "type": "string" },
        "permissions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "test_profile": {
      "type": "string",
      "enum": ["fast", "standard", "deep"],
      "default": "standard"
    },
    "expected_verdict":    { "type": "string", "enum": ["ALLOW", "WARN", "BLOCK"] },
    "expected_risk_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "expected_capabilities": { "type": "object" },
    "expected_policy": {
      "type": "object",
      "properties": {
        "egress_allowlist": { "type": "array", "items": { "type": "string" } },
        "shell_access":     { "type": "boolean" },
        "env_allowlist":    { "type": "array", "items": { "type": "string" } },
        "max_memory_mb":    { "type": "integer" },
        "timeout_seconds":  { "type": "integer" }
      }
    },
    "expected_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title_contains":   { "type": "string" },
          "minimum_severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
